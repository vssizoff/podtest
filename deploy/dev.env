APP_ENV=development
JUDGING_NO_INVOKER=true
HTTP_BIND=127.0.0.1:8088
PUBLIC_URL=http://localhost:8088
POSTGRES_USER=podtest
POSTGRES_DB=podtest
POSTGRES_PASSWORD=podtest-local-db
DATABASE_URL=postgres://podtest:podtest-local-db@postgres:5432/podtest?sslmode=disable
S3_BUCKET=podtest
S3_ACCESS_KEY=podtest-local
S3_SECRET_KEY=podtest-local-storage
OIDC_ISSUER_URL=http://localhost:8088/dex
OIDC_CLIENT_ID=podtest-local
OIDC_CLIENT_SECRET=podtest-local-client
